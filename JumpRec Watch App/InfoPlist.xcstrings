    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec reads health information to measure and summarize your workout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRecは、ワークアウトを計測してまとめるために、ヘルスケア情報を読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec은 운동을 측정하고 요약하기 위해 건강 정보를 읽습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 读取健康信息以测量并总结您的运动数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 會讀取健康資訊以測量並彙整您的運動資料。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec saves your workout and active energy data to Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRecは、ワークアウトとアクティブエネルギーのデータをヘルスケアに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec은 운동 및 활동 에너지 데이터를 건강 앱에 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 会将您的运动和活动能量数据保存至“健康”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 會將您的運動與活動能量資料儲存至「健康」。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec uses motion data to detect jumps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRecは、ジャンプを検出するためにモーションデータを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec은 점프를 감지하기 위해 동작 데이터를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 使用动作数据来检测跳跃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JumpRec 使用動作資料來偵測跳躍。"
          }
        }
      }
    }
  },
  "version" : "1.3"

          }
        }
      }
    },
    "The number of detected pauses longer than 5 seconds and up to 15 seconds between jumps." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプの間に5秒を超え、15秒以下の休憩・中断が検出された回数です。"

    "The number of double-unders detected during your workout. Double-under detection is only available when your workout is recorded with Apple Watch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト中に検出された二重跳びの回数です。二重跳びの検出は、Apple Watchでワークアウトを記録した場合にのみ表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动期间检测到的双摇次数。双摇检测仅在使用 Apple Watch 记录运动时可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

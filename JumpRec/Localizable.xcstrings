        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未能偵測到跳躍，請嘗試提高靈敏度。"
          }
        }
      }
    },
    "If jumps are not detected, try lowering the threshold." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {

    "Includes sessions with 100+ jumps. When you complete 10 workouts, unlock lifetime unlimited tracking with a single purchase." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes sessions with 100+ jumps. When you complete 10 workouts, unlock lifetime unlimited tracking with a single purchase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100回以上のジャンプを完了したセッションが対象です。10回完了後は、1回限りの購入で無制限のワークアウトをアンロックできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "100회 이상 점프한 운동이 포함됩니다. 운동을 10회 완료하면 한 번의 구입으로 평생 무제한 운동 기록을 잠금 해제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "包含 100+ 次跳跃的训练。完成 10 次训练后，一次购买即可永久解锁无限记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "包含 100 下以上的運動。完成 10 次運動後，單次購買即可永久解鎖無限追蹤。"
          }
        }
      }
    },

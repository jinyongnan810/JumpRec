    "iCloud access is restricted on this device, so cloud-backed sessions cannot be restored right now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは iCloud へのアクセスが制限されているため、iCloud に保存されたセッションは現在復元できません。"
          }
        }
      }
    },
    "iCloud is temporarily unavailable. Previously synced sessions may reappear once the account becomes reachable again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud は一時的に利用できません。アカウントに再び接続できるようになると、以前同期されたセッションが再表示される場合があります。"
          }
        }
      }
    },
    "If Apple Watch cannot start, iPhone will be used." : {

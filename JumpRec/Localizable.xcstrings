    "If Apple Watch cannot start, supported headphones will be used when available." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchでワークアウトを開始できない場合は、利用可能であれば対応ヘッドフォンを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에서 시작할 수 없는 경우, 사용 가능한 지원 헤드폰을 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "If jumps are not detected, try increasing the sensitivity." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If jumps are not detected, try increasing the sensitivity."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプが検知されない場合は、感度を高くしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄넘기가 감지되지 않으면 민감도를 높여 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

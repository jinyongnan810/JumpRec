    "Includes sessions with 100+ jumps. When you complete 10 workouts, unlock lifetime unlimited tracking with a single purchase." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes sessions with 100+ jumps. When you complete 10 workouts, unlock lifetime unlimited tracking with a single purchase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100回以上のジャンプを完了したセッションが対象です。10回完了後は、1回限りの購入で無制限のワークアウトをアンロックできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100회 이상 뛴 세션이 포함됩니다. 10회 완료 후 단 한 번의 결제로 평생 무제한 기록을 잠금 해제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 100 次以上跳跃的训练。完成 10 次后，通过一次购买即可终身解锁无限次记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含 100 下以上跳躍的運動。完成 10 次後，透過單次購買即可終身解鎖無限次記錄。"
          }
        }
      }
    },

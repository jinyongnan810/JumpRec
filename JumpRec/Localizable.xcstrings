    "A normalized score that reflects how evenly you maintained your jumping pace throughout the session." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション全体を通して、どれだけ一定のペースで跳び続けられたかを示す正規化スコアです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "운동 내내 점프 페이스를 얼마나 일정하게 유지했는지 나타내는 정규화된 점수입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一项标准化评分，反映你在整个训练过程中保持跳跃节奏的稳定程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一項標準化分數，反映你在整個運動過程中維持跳躍節奏的穩定程度。"
          }
        }
      }
    },

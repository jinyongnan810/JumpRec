          }
        }
      }
    },
    "If jumps are not detected, try increasing the sensitivity." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If jumps are not detected, try increasing the sensitivity."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプが検知されない場合は、感度を高くしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄넘기가 감지되지 않으면 민감도를 높여 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未能检测到跳跃，请尝试提高灵敏度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未能偵測到跳躍，請嘗試提高靈敏度。"
          }
        }
      }
    },
    "If there are false detections, try lowering the sensitivity." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there are false detections, try lowering the sensitivity."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤検知が多い場合は、感度を低くしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오감지가 발생하면 민감도를 낮춰 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果出现误检，请尝试降低灵敏度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果出現誤判，請嘗試降低靈敏度。"
          }
        }

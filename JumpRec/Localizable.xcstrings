    "A normalized score that reflects how evenly you maintained your jumping pace throughout the session." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション全体を通して、どれだけ一定のペースで跳び続けられたかを示す正規化スコアです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 전체에서 줄넘기 페이스를 얼마나 일정하게 유지했는지 나타내는 정규화된 점수입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反映您在整个训练过程中保持均匀跳跃节奏的标准化评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反映您在整個運動過程中維持穩定跳躍節奏的標準化分數。"
          }
        }
      }
    },

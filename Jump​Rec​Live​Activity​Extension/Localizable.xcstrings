    "No iCloud account is currently signed in, so previous cloud-backed workouts cannot be restored on this device yet." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在このデバイスでは iCloud にサインインしていないため、以前 iCloud に保存されたワークアウトはまだ復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "현재 iCloud 계정에 로그인되어 있지 않아 이전에 클라우드에 백업된 운동을 아직 이 기기에서 복원할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "当前未登录 iCloud 账户，因此暂无法在此设备上恢复之前备份在云端的训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "目前尚未登入iCloud帳號，因此暫時無法在此裝置上回復先前備份在雲端的運動。"
          }
        }
      }
    },

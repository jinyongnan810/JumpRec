    "Allow Health Access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアへのアクセスを許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 데이터 접근 허용"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问健康数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許存取健康資料"
          }
        }
      }
    },
    "Allow JumpRec to save workouts in Health before starting. Review access in JumpRec Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始する前に、JumpRecによるヘルスケアへのワークアウトの保存を許可してください。JumpRecの設定でアクセス許可を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작하기 전에 JumpRec이 건강 앱에 운동을 저장하도록 허용해 주세요. JumpRec 설정에서 권한을 확인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在开始前允许 JumpRec 将训练保存至“健康”。您可以在 JumpRec 设置中查看权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在開始前允許 JumpRec 將運動儲存至「健康」。您可以在 JumpRec 設定中檢視權限。"
          }
        }
      }
    },
    "Allow Motion & Fitness access in JumpRec’s system settings before starting a headphone workout." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドフォンでワークアウトを開始する前に、システム設定のJumpRecで「モーションとフィットネス」へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드폰으로 운동을 시작하기 전에 시스템 설정의 JumpRec에서 ‘동작 및 피트니스’ 접근 권한을 허용해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用耳机开始训练前，请在系统设置的 JumpRec 中允许“运动与健身”访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用耳機開始運動前，請在系統設定的 JumpRec 中允許「動作與健身」存取權限。"
          }
        }
      }
    },

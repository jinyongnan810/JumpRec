    "Allow Health Access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアへのアクセスを許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "건강 접근 허용"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许访问健康"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允許存取「健康」"
          }
        }
      }
    },
    "Allow JumpRec to save workouts in Health before starting. Review access in JumpRec Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始する前に、JumpRecによるヘルスケアへのワークアウトの保存を許可してください。JumpRecの設定でアクセス許可を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "시작하기 전에 JumpRec이 건강에 운동을 저장하도록 허용해 주세요. JumpRec 설정에서 접근 권한을 확인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开始前，请允许 JumpRec 将训练保存到“健康”。请在 JumpRec 的“设置”中查看访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開始前，請允許JumpRec將運動儲存至「健康」。請在JumpRec的「設定」中查看存取權限。"
          }
        }
      }
    },
    "Allow Motion & Fitness access in JumpRec’s system settings before starting a headphone workout." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドフォンでワークアウトを開始する前に、システム設定のJumpRecで「モーションとフィットネス」へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "헤드폰으로 운동을 시작하기 전에 시스템 설정의 JumpRec에서 ‘동작 및 피트니스’ 접근을 허용해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "开始耳机训练前，请在 JumpRec 的系统设置中允许访问“运动与健身”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開始耳機運動前，請在JumpRec的系統設定中允許存取「動作與健身」。"
          }
        }
      }
    },

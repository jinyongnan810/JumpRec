    "Motion access is requested when you start a workout with supported headphones." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するヘッドフォンでワークアウトを開始すると、モーションへのアクセスが求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 헤드폰으로 운동을 시작할 때 동작 접근 권한을 요청합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您使用支持的耳机开始训练时，将请求动作访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您使用支援的耳機開始運動時，將要求動作存取權限。"
          }
        }
      }
    },
    "No iCloud account is currently signed in, so previous cloud-backed workouts cannot be restored on this device yet." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在このデバイスでは iCloud にサインインしていないため、以前 iCloud に保存されたワークアウトはまだ復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 iCloud 계정에 로그인되어 있지 않아 이전에 클라우드에 백업된 운동을 아직 복원할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前未登录 iCloud 账户，因此暂无法在此设备上恢复此前备份至云端的训练记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前未登入 iCloud 帳號，因此暫時無法在此裝置上回復先前備份至雲端的運動紀錄。"
          }
        }
      }
    },

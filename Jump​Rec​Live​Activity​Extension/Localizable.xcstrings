    "Motion access is requested when you start a workout with supported headphones." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するヘッドフォンでワークアウトを開始すると、モーションへのアクセスが求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {

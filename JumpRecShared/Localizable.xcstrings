    "On Apple Watch, open Settings, then Health, and select JumpRec to review access." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Watchで「設定」→「ヘルスケア」を開き、JumpRecを選択してアクセス許可を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple Watch에서 ‘설정’을 연 다음 ‘건강’에서 JumpRec을 선택해 접근 권한을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在 Apple Watch 上打开“设置”，前往“健康”，然后选择 JumpRec 查看访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在Apple Watch上開啟「設定」，點選「健康」並選擇JumpRec，即可查看存取權限。"
          }
        }
      }
    },
    "Open App Settings" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アプリの設定を開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "앱 설정 열기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

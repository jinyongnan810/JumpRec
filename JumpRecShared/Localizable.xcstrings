            "state" : "machine_translated",
            "value" : "請再試一次，或在系統設定中查看JumpRec的權限。"
          }
        }
      }
    },
    "Product details could not be loaded from the App Store. Please check your internet connection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Storeから製品情報を読み込めませんでした。通信環境をご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App Store에서 제품 정보를 불러올 수 없습니다. 인터넷 연결을 확인해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

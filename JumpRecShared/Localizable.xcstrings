          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開啟App設定"
          }
        }
      }
    },
    "Open Health on iPhone, tap your profile, then Apps under Privacy, and select JumpRec." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iPhoneで「ヘルスケア」を開き、プロフィール→「プライバシー」の「アプリ」→JumpRecを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iPhone에서 ‘건강’을 열고 프로필을 탭한 다음 ‘개인정보 보호’ 아래의 ‘앱’에서 JumpRec을 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在 iPhone 上打开“健康”，轻点你的个人资料，然后在“隐私”下选择“App”，再选择 JumpRec。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在iPhone上開啟「健康」，點一下個人檔案，然後在「隱私權」下點選「App」，再選擇JumpRec。"
          }
        }
      }
    },
    "Please try again or review JumpRec’s permissions in system settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "もう一度お試しいただくか、システム設定でJumpRecのアクセス許可を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "다시 시도하거나 시스템 설정에서 JumpRec의 권한을 확인해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请重试，或在系统设置中查看 JumpRec 的权限。"
